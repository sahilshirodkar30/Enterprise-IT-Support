
# GoaGuide AI - Colang 1.0 rules

# -------------------------------------------------
# DEFAULT REFUSAL
# -------------------------------------------------

define bot refuse to respond
    "Sorry, I can only help with Goa travel-related questions. I cannot process this request."

# -------------------------------------------------
# FACT CHECKING
# -------------------------------------------------

define subflow self check facts

    if $check_facts == True

        $check_facts = False

        $accuracy = execute self_check_facts

        if $accuracy < 0.5

            bot refuse to respond

            stop
